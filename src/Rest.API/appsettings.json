{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/rest-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 52428800,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Rest.API",
    "Audience": "Rest.Client",
    "SigningKey": "",
    "AccessTokenMinutes": 20,
    "RefreshTokenDays": 14,
    "ClockSkewSeconds": 30
  },
  "Security": {
    "Pbkdf2Iterations": 210000
  },
  "Database": {
    "Provider": "SqlServer",
    "ConnectionString": "Server=localhost;Database=RestDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "CommandTimeoutSeconds": 60,
    "InitializeOnStartup": false,
    "SeedOnStartup": false,
    "AuditRetentionDays": 90
  },
  "Storage": {
    "Provider": "Local",
    "BucketName": "",
    "Region": "ap-south-1",
    "ForcePathStyle": false,
    "Prefix": "documents",
    "UseServerSideEncryption": true,
    "PresignedUrlMinutes": 15,
    "LocalRootPath": "storage",
    "LocalDownloadBasePath": "/api/v1/files",
    "MaxFileSizeBytes": 26214400,
    "AllowedExtensions": [
      ".pdf", ".docx", ".xlsx", ".pptx", ".doc", ".xls", ".ppt", ".txt", ".csv"
    ]
  },
  "Email": {
    "Provider": "Log",
    "Host": "localhost",
    "Port": 1025,
    "UseStartTls": false,
    "UseSsl": false,
    "FromEmail": "no-reply@example.com",
    "FromName": "Rest API",
    "TimeoutSeconds": 30
  },
  "AuditLog": {
    "Enabled": true,
    "CaptureRequestBody": true,
    "CaptureResponseBody": true,
    "MaxBodyCharacters": 8000,
    "QueueCapacity": 10000,
    "BatchSize": 50,
    "FlushSeconds": 2,
    "RetentionDays": 90,
    "ExcludedPaths": [ "/health", "/openapi", "/scalar", "/hubs" ],
    "SensitiveJsonKeys": [
      "password", "newPassword", "currentPassword", "token", "refreshToken",
      "accessToken", "authorization", "secret", "clientSecret", "apiKey"
    ]
  },
  "RateLimiting": {
    "Enabled": true,
    "GlobalPermitLimit": 100,
    "GlobalWindowSeconds": 60,
    "GlobalQueueLimit": 0,
    "UserPermitLimit": 300,
    "UserWindowSeconds": 60,
    "AuthPermitLimit": 8,
    "AuthWindowSeconds": 60
  },
  "Cors": {
    "AllowedOrigins": [],
    "AllowLocalhostAnyPort": true,
    "AllowCredentials": true
  },
  "VirusScan": {
    "Provider": "None",
    "Host": "localhost",
    "Port": 3310,
    "TimeoutSeconds": 60
  },
  "Notifications": {
    "Enabled": true,
    "PollIntervalSeconds": 15,
    "BatchSize": 25,
    "LockMinutes": 5,
    "MaxAttempts": 5
  },
  "BackgroundJobs": {
    "RunAuditWriter": true,
    "RunNotificationDispatcher": false,
    "RunAuditRetention": false,
    "RunDashboardBroadcast": true,
    "DashboardIntervalSeconds": 5,
    "RetentionSweepHours": 24
  },
  "Seed": {
    "AdminEmail": "admin@example.com",
    "AdminPassword": "",
    "AdminDisplayName": "Administrator"
  }
}

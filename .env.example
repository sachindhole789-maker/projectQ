# Copy to .env (git-ignored) and fill in your own values.
# No real credentials are stored in this repository.

# Required by docker-compose.yml. Choose a strong password for the local
# SQL Server container and use the same value in your local API overrides.
MSSQL_SA_PASSWORD=

# LocalStack accepts any non-empty values; these are local-only dummies.
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
